# This studio renders locally. Optional network-dependent providers are disabled by default.
WONDERTOONS_ALLOW_NETWORK_FEATURES=false

# Optional local storage overrides (defaults to ./data and ./data/tmp)
WONDERTOONS_DATA_DIR=
WONDERTOONS_TEMP_DIR=

# Story generation
WONDERTOONS_SUPPORTED_LANGUAGES=en,ta
WONDERTOONS_STORY_PROVIDER=mock
# The external_llm provider remains an unimplemented stub; no API key is needed.
WONDERTOONS_LLM_API_KEY=

# Local server settings
WONDERTOONS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WONDERTOONS_JOB_WORKERS=2
WONDERTOONS_MAX_SCENES=200

# Optional absolute paths if FFmpeg/FFprobe are not on PATH
WONDERTOONS_FFMPEG_PATH=
WONDERTOONS_FFPROBE_PATH=
